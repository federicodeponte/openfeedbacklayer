# Required: install openfeedbacklayer with @supabase/supabase-js
# npm install openfeedbacklayer @supabase/supabase-js

# Required: Supabase project URL
SUPABASE_URL=https://xxx.supabase.co

# Required: Supabase service role key for server-side database and storage writes
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Optional: AI classification. Set EITHER (OpenAI is preferred when both
# are present — the Gemini free tier caps at 20 requests/day).
# OpenAI — uses gpt-4o-mini by default; override with OPENAI_MODEL.
OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# Google Gemini — uses gemini-2.5-flash-lite.
GEMINI_API_KEY=AIzaSyxxx

# Optional: Resend API key for owner and subscriber email notifications
RESEND_API_KEY=re_xxx

# Optional: Email address that receives new feedback notifications
FEEDBACK_NOTIFY_EMAIL=you@example.com

# Optional: From address for owner and subscriber emails
RESEND_FROM_EMAIL=feedback@yourdomain.com

# Optional: GitHub token for opening feedback issues
GITHUB_TOKEN=github_pat_xxx

# Optional: GitHub repo for feedback issues, in owner/name format
GITHUB_FEEDBACK_REPO=owner/name

# Optional: Secret used to verify GitHub Issues webhooks
GITHUB_WEBHOOK_SECRET=change-me
